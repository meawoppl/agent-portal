{
  "name": "agent-portal-css-lint",
  "version": "0.1.0",
  "private": true,
  "description": "CSS linting for agent-portal frontend",
  "scripts": {
    "lint:css": "stylelint --config .stylelintrc.json \"../styles/**/*.css\" \"../../aperture-frontend/styles/**/*.css\"",
    "lint:css:fix": "stylelint --config .stylelintrc.json \"../styles/**/*.css\" \"../../aperture-frontend/styles/**/*.css\" --fix",
    "test:sw": "node --test sw.test.js"
  },
  "devDependencies": {
    "stylelint": "^16.2.0",
    "stylelint-config-standard": "^36.0.0"
  }
}
